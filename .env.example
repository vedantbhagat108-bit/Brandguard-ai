# Required for live Gemini 3.8 Flash & Embedding-2 analysis (falls back to deterministic engine if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Secret key for signing JWT authentication tokens and short-lived visual preview URLs (has a built-in fallback if omitted)
JWT_SECRET_KEY=brandlens-ai-secure-secret-key-2026

# Optional: Visual Assets RAG module configuration
VISUAL_MAX_FILE_SIZE_BYTES=8388608
VISUAL_SIGNED_URL_TTL_SECONDS=900
VISUAL_ENABLE_AI_VISION=true
